<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        ⚠️ `usesCleartextTraffic` FAQAT DEBUG QURILISHIDA.

        Ishlab chiqishda server kompyuterda HTTP bilan ishlaydi va
        emulyator unga `http://10.0.2.2:4000` orqali chiqadi.
        Android 9+ esa ochiq HTTP ni standart holda BLOKLAYDI —
        ilova "Internetga ulanib bo'lmadi" deb ko'rsatardi, aslida
        esa internet joyida va xato faqat `adb logcat` da
        ("Cleartext HTTP traffic not permitted") ko'rinardi.

        ⚠️ RELEASE'DA YO'Q va bo'lmasligi kerak: u yerda ilova faqat
        HTTPS backend bilan ishlaydi. Asosiy manifestga yozilsa,
        tasodifan HTTP manzilga yozilgan so'rov do'kondagi ilovada
        ham jimgina ketib, ma'lumot ochiq uzatilardi.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>

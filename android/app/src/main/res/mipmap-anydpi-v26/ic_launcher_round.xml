<?xml version="1.0" encoding="utf-8"?>
<!--
    ADAPTIVE BELGI (Android 8+).

    Android foreground ni o'z niqobi bilan kesadi (doira, kvadrat,
    tomchi — ishlab chiqaruvchiga qarab). Shuning uchun rasm va fon
    ALOHIDA beriladi: fon butun maydonni to'ldiradi, rasm esa
    markazda, xavfsiz maydon ichida turadi.

    ⚠️ Busiz Android eski `ic_launcher.png` ni O'ZI kesadi va
    yumaloq niqobda belgining chetlari qirqilib ketardi.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

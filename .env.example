PORT=3100

# ── SERVERGA ULANISH ──────────────────────────────────────────────────
#
# IKKI USUL BOR:
#
# 1) PROKSI (Telegram mini-ilova uchun TAVSIYA ETILADI)
#    Ilova so'rovni o'ziga yuboradi, Next uni serverga uzatadi.
#    BITTA HTTPS manzil yetarli, CORS kerak emas, server manzili
#    mijoz bundle'iga tushmaydi.
#
#      API_PROXY_TARGET=http://localhost:4000
#      NEXT_PUBLIC_API_URL=/api
#
# 2) TO'G'RIDAN-TO'G'RI (admin panel bilan ayni usul)
#    Server ham HTTPS bo'lishi SHART: brauzer HTTPS sahifadan
#    HTTP manzilga so'rovni bloklaydi.
#
#      NEXT_PUBLIC_API_URL=https://api.example.uz/api
#
API_PROXY_TARGET=http://localhost:4000
NEXT_PUBLIC_API_URL=/api

# ── TUNNEL (faqat ishlab chiqishda) ───────────────────────────────────
# Telegram bilan sinash uchun ilovani HTTPS tunnel orqali ochganda
# domenni shu yerga yozing (vergul bilan bir nechta).
# ⚠️ Busiz sahifa yuklanadi, lekin React hidratatsiya BO'LMAYDI va
# ekran "Ilova ochilmoqda..." holatida qotib qoladi.
ALLOWED_DEV_ORIGINS=""
